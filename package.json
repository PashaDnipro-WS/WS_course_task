{
  "name": "QA_course",
  "type": "module",
  "devDependencies": {
    "@wdio/allure-reporter": "^9.27.1",
    "@wdio/cli": "^9.27.0",
    "@wdio/local-runner": "^9.27.0",
    "@wdio/mocha-framework": "^9.27.0",
    "@wdio/spec-reporter": "^9.27.0",
    "allure-commandline": "^2.41.0",
    "cross-env": "^10.1.0"
  },
  "scripts": {
    "test:test": "wdio run wdio.conf.js --spec ./test/specs/test.e2e.js",
    "test:hw": "wdio run wdio.conf.js --spec ./test/specs/hw.js",
    "test:pinterest:homepage": "wdio run ./config/wdio.conf.js --spec pinterest/test/specs/home.page.spec.js",
    "test:dev": "cross-env ENV=dev wdio run ./config/wdio.chrome.conf.js",
    "test:uat": "cross-env ENV=uat wdio run ./config/wdio.chrome.conf.js",
    "test": "wdio run ./config/wdio.conf.js",
    "test:chrome": "wdio run ./config/wdio.chrome.conf.js",
    "test:firefox": "wdio run ./config/wdio.firefox.conf.js",
    "test:edge": "wdio run ./config/wdio.edge.conf.js",
    "docker:chrome": "docker compose run --rm chrome",
    "docker:firefox": "docker compose run --rm firefox",
    "docker:edge": "docker compose run --rm edge",

    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open"
  }
}
